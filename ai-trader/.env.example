# ===== AI =====
# ใส่ API key จาก https://console.anthropic.com เพื่อให้ Claude เป็นคนตัดสินใจเทรด
# ถ้าไม่ใส่ บอทจะใช้กลยุทธ์ indicator ในตัว (ไม่ใช้ AI) แทน
ANTHROPIC_API_KEY=

# claude | rules  (ปล่อยว่าง = ใช้ claude ถ้ามี key, ไม่มีก็ใช้ rules)
AI_PROVIDER=
# โมเดลที่ใช้ — claude-opus-5-5 (ฉลาดสุดในตระกูล Opus), claude-sonnet-5-5 (ถูกลงครึ่งหนึ่ง), claude-haiku-5-5 (ถูกสุด)
CLAUDE_MODEL=claude-opus-5-5
# ความลึกในการคิด: low | medium | high | xhigh | max  (สูง = แม่นขึ้นแต่แพงและช้าขึ้น)
CLAUDE_EFFORT=medium

# ===== ข้อมูลราคา =====
# auto = ใช้ราคาจริงจาก Binance ถ้าเชื่อมต่อได้ ไม่งั้นใช้ราคาจำลอง | binance | simulated
MARKET_DATA=auto
BINANCE_BASE_URL=https://data-api.binance.vision

# ===== เว็บ =====
PORT=3000
# 127.0.0.1 = เปิดได้เฉพาะเครื่องนี้ (ปลอดภัยสุด) | 0.0.0.0 = เปิดให้เครื่องอื่นในเครือข่ายเข้าได้ (ต้องตั้งรหัสผ่านด้านล่าง)
HOST=127.0.0.1
# ถ้าตั้งไว้ เว็บจะถามรหัสผ่าน (username อะไรก็ได้)
DASHBOARD_PASSWORD=
